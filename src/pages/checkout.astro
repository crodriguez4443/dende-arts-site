---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Checkout - Dende Arts" noindex={true}>
  <div class="checkout-loading">
    Redirecting to checkout...
  </div>
</Layout>

<script is:inline>
  // Meta Shops appends ?products=<content_id>:<qty>,... to the checkout URL set
  // in Commerce Manager. Content ids are assigned by Meta's catalog and can't be
  // derived from Swell, so the size each one means has to be stated here.
  const PRODUCT_ID = '6796e8f527aea3001290a682';
  const META_SIZES = { '1': 'XS', '2': 'S', '3': 'M', '4': 'L', '5': 'XL' };

  document.addEventListener('DOMContentLoaded', async () => {
    const w = window;
    if (typeof w.initializeSwell === 'function') await w.initializeSwell();
    if (!w.swell) {
      console.error('Swell not initialized');
      return;
    }
    try {
      const products = new URLSearchParams(location.search).get('products');
      if (products) {
        const items = [];
        for (const entry of products.split(',')) {
          const [contentId, qty] = entry.split(':');
          const size = META_SIZES[contentId];
          if (!size) {
            console.error('Unknown Meta content id:', contentId);
            continue;
          }
          items.push({
            product_id: PRODUCT_ID,
            quantity: Math.max(1, parseInt(qty, 10) || 1),
            options: { Size: size },
          });
        }
        // Every id was unknown, so checkout would be empty. Send them somewhere
        // they can still buy rather than to a dead checkout.
        if (!items.length) {
          window.location.replace('/abada-joggers');
          return;
        }
        // One write does the lot: sets the items, attaches the attribution
        // metadata, and returns the checkoutUrl to leave on. Swell cart writes
        // cost ~2s each, so doing this as setItems + update + get would put
        // three of them in the buyer's path instead of one. `items` replaces
        // rather than appends, so reloading the link can't double the cart.
        const cart = await swell.cart.update({
          items,
          metadata: w.getCheckoutMetadata(),
        });
        if (swell.cachedCart) swell.cachedCart.lastFetched = 0;
        // The cart was empty until now, which is the first point a coupon
        // sticks. No-ops without an affiliate cookie, so most buyers pay nothing
        // for it. The coupon doesn't change checkoutUrl, so it's safe after.
        if (typeof w.applyAffiliateCoupon === 'function') await w.applyAffiliateCoupon();
        if (cart?.checkoutUrl) {
          window.location.href = cart.checkoutUrl;
          return;
        }
      }

      // No Meta params (or no checkoutUrl came back): fall back to the site's
      // normal exit, which re-reads the cart and attaches the metadata itself.
      if (!(await w.goToSwellCheckout())) window.location.replace('/abada-joggers');
    } catch (error) {
      console.error('Error redirecting to checkout:', error);
      alert('Error starting checkout. Please try again.');
      window.location.href = '/';
    }
  });
</script>
